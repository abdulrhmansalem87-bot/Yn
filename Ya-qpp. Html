h1{font-size:26px;font-weight:800;margin:8px 0}
h2{font-size:17px;margin:18px 0 8px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:12px}
.card h3{margin:0 0 4px;font-size:17px}
.meta{display:flex;flex-wrap:wrap;gap:4px 14px;color:var(--mute);font-size:14px;margin:4px 0 8px}
.badge{display:inline-block;font-size:13px;font-weight:600;padding:2px 10px;border-radius:99px;background:var(--blubg);color:var(--blu)}
.b-taken,.b-review{background:var(--ambbg);color:var(--amb)}.b-approved{background:var(--okbg);color:var(--ok)}
.rew{font-weight:800;color:var(--pri)}
label{display:block;font-weight:600;font-size:14px;margin:10px 0 4px}
input,select,textarea{width:100%;font:400 16px Cairo,sans-serif;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink)}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--blu);outline-offset:2px}
.btn{border:0;border-radius:10px;padding:9px 14px;font:600 15px Cairo,sans-serif;cursor:pointer;background:var(--pri);color:var(--on)}
.ghost{background:none;border:1px solid var(--line);color:var(--ink)}.ok{background:var(--ok);color:#fff}.bad{background:var(--bad);color:#fff}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;align-items:center}
.top{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px}.top .sp{flex:1}
video,img{width:100%;max-height:260px;object-fit:contain;border-radius:10px;background:#000;margin-top:8px}
.hint{font-size:13px;color:var(--mute);margin-top:6px}.empty{text-align:center;color:var(--mute);padding:24px;border:1px dashed var(--line);border-radius:14px}
.note{font-size:14px;padding:8px 10px;border-radius:10px;background:var(--ambbg);color:var(--amb);margin-top:8px}
.toast{position:fixed;inset-inline:16px;bottom:16px;max-width:420px;margin:auto;background:var(--ink);color:var(--bg);padding:10px 14px;border-radius:12px;text-align:center;font-weight:600;opacity:0;pointer-events:none;transition:opacity .2s}
.toast.show{opacity:1}
</style>
